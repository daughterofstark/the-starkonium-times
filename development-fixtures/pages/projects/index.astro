---
import { getCollection } from 'astro:content';

import Container from '../../components/Container.astro';
import EmptyState from '../../components/EmptyState.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { ContentEntry } from '../../utils/content';
import type { ProjectData, TopicData } from '../../utils/content-schemas';
import { labelFromSlug } from '../../utils/format';
import { selectProjectIndexEntries } from '../../utils/projects';
import { projectStatusMeta, type ProjectStatus } from '../../utils/status';

const projectEntries = (await getCollection(
  'projects',
)) as ContentEntry<ProjectData>[];
const topics = (await getCollection('topics')) as ContentEntry<TopicData>[];
const projects = selectProjectIndexEntries(projectEntries);

const statuses = Array.from(
  new Set(projects.map((project) => project.data.status)),
).sort((a, b) =>
  projectStatusMeta[a].label.localeCompare(projectStatusMeta[b].label),
);

const fields = Array.from(
  new Set(projects.map((project) => project.data.field)),
).sort((a, b) => getTopicLabel(a).localeCompare(getTopicLabel(b)));

function getTopicLabel(slug: string) {
  return (
    topics.find((topic) => topic.data.slug === slug)?.data.label ??
    labelFromSlug(slug)
  );
}
---

<BaseLayout
  title="Projects — The Starkonium Times"
  description="An editorial list of public project fixtures for The Starkonium Times."
>
  <Container as="section" class="projects-page" aria-label="Projects">
    <PageHeader
      eyebrow="Projects"
      title="Projects"
      standfirst="A working index of research, software, analysis, and writing projects. Phase 5 keeps this intentionally editorial: no sortable catalogue, no image grid, and no inflated project claims."
    />

    <section class="projects-summary" aria-label="Project count">
      <p>
        <span data-project-count>{projects.length}</span>
        <span data-project-count-label>
          {projects.length === 1 ? 'public project' : 'public projects'}
        </span>
      </p>
    </section>

    <form
      class="projects-filters"
      data-project-filters
      aria-label="Project filters"
    >
      <div>
        <label for="project-status">Status</label>
        <select id="project-status" name="status">
          <option value="">All statuses</option>
          {
            statuses.map((status) => (
              <option value={status}>
                {projectStatusMeta[status as ProjectStatus].label}
              </option>
            ))
          }
        </select>
      </div>
      <div>
        <label for="project-field">Field</label>
        <select id="project-field" name="field">
          <option value="">All fields</option>
          {
            fields.map((field) => (
              <option value={field}>{getTopicLabel(field)}</option>
            ))
          }
        </select>
      </div>
      <a href="/projects" data-clear-filters>Clear filters</a>
    </form>

    <SectionHeader
      id="project-list"
      title="Project record"
      intro="Sorted by derived update date, then title."
    />

    <div class="projects-list" aria-labelledby="project-list" data-project-list>
      {
        projects.length > 0 ? (
          projects.map((project) => (
            <div
              data-project-item
              data-status={project.data.status}
              data-field={project.data.field}
            >
              <ProjectPreview project={project} topics={topics} />
            </div>
          ))
        ) : (
          <EmptyState message="No public projects are ready yet." />
        )
      }
    </div>

    <div class="projects-empty" data-filter-empty hidden>
      <EmptyState
        message="No projects match those filters."
        action={{ label: 'Clear filters', href: '/projects' }}
      />
    </div>
  </Container>
</BaseLayout>

<script is:inline>
  const form = document.querySelector('[data-project-filters]');
  const statusControl = document.querySelector('#project-status');
  const fieldControl = document.querySelector('#project-field');
  const items = Array.from(document.querySelectorAll('[data-project-item]'));
  const count = document.querySelector('[data-project-count]');
  const countLabel = document.querySelector('[data-project-count-label]');
  const emptyState = document.querySelector('[data-filter-empty]');

  function applyFilters() {
    const status = statusControl.value;
    const field = fieldControl.value;
    let visibleCount = 0;

    for (const item of items) {
      const matchesStatus = !status || item.dataset.status === status;
      const matchesField = !field || item.dataset.field === field;
      const visible = matchesStatus && matchesField;
      item.hidden = !visible;
      if (visible) visibleCount += 1;
    }

    count.textContent = String(visibleCount);
    countLabel.textContent =
      visibleCount === 1 ? 'public project' : 'public projects';
    emptyState.hidden = visibleCount > 0;

    const url = new URL(window.location.href);
    if (status) {
      url.searchParams.set('status', status);
    } else {
      url.searchParams.delete('status');
    }
    if (field) {
      url.searchParams.set('field', field);
    } else {
      url.searchParams.delete('field');
    }
    window.history.replaceState({}, '', url);
  }

  function hydrateFromUrl() {
    const params = new URLSearchParams(window.location.search);
    statusControl.value = params.get('status') ?? '';
    fieldControl.value = params.get('field') ?? '';
    applyFilters();
  }

  if (
    form &&
    statusControl &&
    fieldControl &&
    count &&
    countLabel &&
    emptyState
  ) {
    form.addEventListener('change', applyFilters);
    hydrateFromUrl();
  }
</script>

<style>
  .projects-page {
    display: grid;
    gap: var(--space-7);
    padding-block: clamp(var(--space-7), 8vw, var(--space-11));
  }

  .projects-summary {
    border-block: 1px solid var(--rule-strong);
    padding-block: var(--space-4);
  }

  .projects-summary p {
    color: var(--ink-700);
    font-family: var(--font-interface);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .projects-summary span:first-child {
    color: var(--orange-ink);
  }

  .projects-filters {
    align-items: end;
    border-block-end: 1px solid var(--rule);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(2, minmax(10rem, 1fr)) auto;
    padding-block-end: var(--space-5);
  }

  .projects-filters div {
    display: grid;
    gap: var(--space-2);
  }

  .projects-filters label,
  .projects-filters a {
    color: var(--ink-500);
    font-family: var(--font-interface);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .projects-filters select {
    background: var(--paper-raised);
    border: 1px solid var(--rule-strong);
    border-radius: 0;
    color: var(--ink-900);
    font: inherit;
    min-block-size: 2.75rem;
    padding: 0 var(--space-3);
  }

  .projects-filters a {
    color: var(--orange-ink);
    padding-block: var(--space-3);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.22em;
  }

  .projects-list {
    display: grid;
    gap: var(--space-5);
  }

  .projects-empty {
    margin-block-start: calc(var(--space-5) * -1);
  }

  [data-project-item][hidden],
  [data-filter-empty][hidden] {
    display: none;
  }

  @media (max-width: 46rem) {
    .projects-filters {
      align-items: stretch;
      grid-template-columns: 1fr;
    }
  }
</style>
