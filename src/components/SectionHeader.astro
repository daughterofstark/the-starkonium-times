---
import InsertionCaret from './InsertionCaret.astro';

interface Props {
  title: string;
  intro?: string;
  href?: string;
  linkLabel?: string;
  level?: 2 | 3;
  caret?: boolean;
}

const {
  title,
  intro,
  href,
  linkLabel = 'View all',
  level = 2,
  caret = false,
} = Astro.props as Props;
const Heading = `h${level}` as const;
---

<header class="section-header">
  <div>
    <Heading>
      {caret && <InsertionCaret />}
      <span>{title}</span>
    </Heading>
    {intro && <p>{intro}</p>}
  </div>
  {href && <a href={href}>{linkLabel}</a>}
</header>

<style>
  .section-header {
    align-items: end;
    border-block-end: 1px solid var(--rule);
    display: flex;
    gap: var(--space-4);
    justify-content: space-between;
    padding-block-end: var(--space-3);
  }

  .section-header h2,
  .section-header h3 {
    align-items: baseline;
    display: inline-flex;
    gap: var(--space-2);
    font-family: var(--font-interface);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .section-header p {
    color: var(--ink-700);
    margin-block-start: var(--space-2);
  }

  .section-header a {
    color: var(--ink-700);
    flex: 0 0 auto;
    font-family: var(--font-interface);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }
</style>
