---
import type { HTMLAttributes } from 'astro/types';

interface Props {
  as?: 'div' | 'section' | 'article' | 'nav' | 'aside';
  class?: string;
  width?: 'content' | 'reading' | 'full';
}

const {
  as: Element = 'div',
  class: className,
  width = 'content',
  ...attributes
} = Astro.props as Props & HTMLAttributes<'div'>;
const widthClass = width === 'reading' ? 'reading-measure' : '';
const classes = ['container', widthClass, className].filter(Boolean).join(' ');
---

<Element {...attributes} class={classes}>
  <slot />
</Element>
