---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props as Props;
const email = 'contact@example.com';
const links = [
  { href: 'https://github.com/daughterofstark', label: 'GitHub', rel: 'me' },
  { href: '/cv.pdf', label: 'CV', rel: undefined },
  { href: '/rss.xml', label: 'RSS', rel: undefined },
];
---

<section
  class:list={['contact-block', compact && 'contact-block--compact']}
  id={compact ? undefined : 'contact'}
  aria-labelledby={compact ? undefined : 'contact-heading'}
>
  {!compact && <h2 id="contact-heading">Contact</h2>}
  <p class="contact-block__email">{email}</p>
  <p>
    Email is plain text for copying. The address is a placeholder until the real
    contact preference is configured.
  </p>
  <ul aria-label="External and reference links">
    {
      links.map((link) => (
        <li>
          <a href={link.href} rel={link.rel}>
            {link.label}
            <span aria-hidden="true"> ↗</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .contact-block {
    border-block: 1px solid var(--rule-strong);
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  .contact-block h2,
  .contact-block__email,
  .contact-block ul {
    font-family: var(--font-interface);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-block h2 {
    font-size: 0.82rem;
  }

  .contact-block__email {
    color: var(--ink-900);
    font-size: var(--step-1);
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .contact-block p:not(.contact-block__email) {
    color: var(--ink-700);
    max-inline-size: var(--w-reading);
  }

  .contact-block ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contact-block a {
    color: var(--orange-ink);
    font-size: var(--step--1);
  }

  .contact-block--compact {
    border-block: 0;
    gap: var(--space-3);
    padding-block: 0;
  }
</style>
