---
import Container from './Container.astro';
import Wordmark from './Wordmark.astro';
import { PRIMARY_NAV_LINKS } from '../lib/shell';
---
<footer class="footer"><Container width="full" class="footer-inner"><Wordmark /><nav aria-label="Footer navigation">{PRIMARY_NAV_LINKS.map(link => <a href={link.href}>{link.label}</a>)}<a href="https://github.com/daughterofstark">GitHub</a></nav><p>© {new Date().getFullYear()} The Starkonium Times · Medha Sharma</p></Container></footer>
<style>.footer{border-top:1px solid var(--rule);padding-block:2.5rem}.footer-inner{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;justify-content:space-between}.footer nav{display:flex;gap:1rem;flex-wrap:wrap}.footer p{font-size:.8rem}</style>
