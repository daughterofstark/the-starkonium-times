---
import Container from './Container.astro';
import ContactBlock from './ContactBlock.astro';
import Wordmark from './Wordmark.astro';
import { PRIMARY_NAV_LINKS } from '../lib/shell';

const siteLinks = [...PRIMARY_NAV_LINKS, { href: '/now', label: 'Now' }];

const referenceLinks = [
  { href: '/archive', label: 'Archive' },
  { href: '/topics', label: 'Topics' },
  { href: '/log', label: 'The Ledger' },
  { href: '/search', label: 'Search' },
];

const externalLinks = [
  { href: 'https://github.com/daughterofstark', label: 'GitHub' },
  { href: '/about#contact', label: 'Contact' },
];
---

<footer class="site-footer">
  <Container class="site-footer__inner" width="full">
    <div class="site-footer__brand">
      <Wordmark />
      <p>
        The Starkonium Times is a future home for research notes, writing,
        project records, and careful public thinking.
      </p>
    </div>
    <nav class="site-footer__nav" aria-label="Footer">
      <div>
        <h2>Site</h2>
        <ul>
          {
            siteLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2>Index</h2>
        <ul>
          {
            referenceLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2>Elsewhere</h2>
        <ul>
          {
            externalLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
    <p class="site-footer__meta">
      Code MIT. Content CC BY 4.0. Built with Astro.
    </p>
    <div class="site-footer__contact">
      <ContactBlock compact />
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    border-block-start: 1px solid var(--rule);
    padding-block: var(--space-7);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-6);
  }

  .site-footer__brand {
    display: grid;
    gap: var(--space-4);
  }

  .site-footer__brand p,
  .site-footer__meta {
    color: var(--ink-500);
    font-size: var(--step--1);
  }

  .site-footer__nav {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
  }

  .site-footer h2 {
    font-family: var(--font-interface);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    margin-block-end: var(--space-3);
    text-transform: uppercase;
  }

  .site-footer ul {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer a {
    color: var(--ink-700);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--ink-900);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .site-footer__meta,
  .site-footer__contact {
    border-block-start: 1px solid var(--rule);
    padding-block-start: var(--space-4);
  }

  .site-footer__meta {
    font-family: var(--font-interface);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: minmax(14rem, 1.3fr) minmax(20rem, 2fr);
    }

    .site-footer__meta,
    .site-footer__contact {
      grid-column: 1 / -1;
    }
  }
</style>
