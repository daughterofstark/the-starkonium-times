---
import { SITE_NAME, WORDMARK_TEXT } from '../lib/shell';

interface Props {
  href?: string;
  class?: string;
}

const { href = '/', class: className } = Astro.props;
const classes = ['wordmark', className].filter(Boolean).join(' ');
---

<a class={classes} href={href} aria-label={SITE_NAME}>
  <span aria-hidden="true">{WORDMARK_TEXT}</span>
</a>

<style>
  .wordmark {
    color: var(--ink-900);
    display: inline-flex;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.99rem + 0.32vw, 1.25rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--ink-900);
  }
</style>
