---
import { getCollection } from 'astro:content';

import Container from '../components/Container.astro';
import EmptyState from '../components/EmptyState.astro';
import MetadataList from '../components/MetadataList.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TopicList from '../components/TopicList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { ContentEntry } from '../utils/content';
import type {
  ExperienceData,
  PersonData,
  ProjectData,
  TopicData,
} from '../utils/content-schemas';
import {
  getExperienceDateRange,
  getExperienceYear,
  getPersonName,
  getRelatedProjectTitles,
  resolveTopicOrText,
  selectExperienceEntries,
} from '../utils/experience';

const rawExperience = (await getCollection(
  'experience',
)) as ContentEntry<ExperienceData>[];
const people = (await getCollection('people')) as ContentEntry<PersonData>[];
const projects = (await getCollection(
  'projects',
)) as ContentEntry<ProjectData>[];
const topics = (await getCollection('topics')) as ContentEntry<TopicData>[];
const entries = selectExperienceEntries(rawExperience);
---

<BaseLayout
  title="Experience — The Starkonium Times"
  description="Experience records for The Starkonium Times, rendered as a compact editorial chronology."
>
  <Container as="section" class="experience-page" aria-label="Experience">
    <PageHeader
      eyebrow="Experience"
      title="Experience"
      standfirst="A concise working record of roles, methods, outputs, and related projects. Entries expand inline and remain readable without JavaScript."
    />

    {
      entries.length > 0 ? (
        <ol class="experience-list">
          {entries.map((entry) => {
            const methods = resolveTopicOrText(entry.data.methods, topics);
            const tools = resolveTopicOrText(entry.data.tools, topics);
            const relatedProjects = getRelatedProjectTitles(
              entry.data.relatedProjects,
              projects,
            );
            const supervisor = getPersonName(entry.data.supervisor, people);
            const topicSlugs = [...entry.data.methods, ...entry.data.tools];

            return (
              <li class="experience-entry">
                <p class="experience-entry__year">{getExperienceYear(entry)}</p>
                <details>
                  <summary>
                    <span>
                      <span class="experience-entry__role">
                        {entry.data.position}
                      </span>
                      <span>{entry.data.organisation}</span>
                    </span>
                    <span>{getExperienceDateRange(entry)}</span>
                  </summary>

                  <div class="experience-entry__body">
                    <MetadataList
                      dense
                      items={[
                        {
                          label: 'Location',
                          value: entry.data.location,
                        },
                        ...(entry.data.group
                          ? [{ label: 'Group', value: entry.data.group }]
                          : []),
                        ...(supervisor
                          ? [{ label: 'Supervisor', value: supervisor }]
                          : []),
                        ...(methods.length > 0
                          ? [
                              {
                                label: 'Methods',
                                value: methods,
                                type: 'chips' as const,
                              },
                            ]
                          : []),
                        ...(tools.length > 0
                          ? [
                              {
                                label: 'Tools',
                                value: tools,
                                type: 'chips' as const,
                              },
                            ]
                          : []),
                      ]}
                    />

                    <section aria-label="Context">
                      <h2>Context</h2>
                      <p>{entry.data.context}</p>
                    </section>

                    <section aria-label="Contribution">
                      <h2>Contribution</h2>
                      <p>{entry.data.contribution}</p>
                    </section>

                    {topicSlugs.length > 0 && (
                      <TopicList
                        slugs={topicSlugs}
                        topics={topics}
                        variant="bordered"
                      />
                    )}

                    {entry.data.outputs.length > 0 && (
                      <section aria-labelledby={`${entry.data.id}-outputs`}>
                        <h2 id={`${entry.data.id}-outputs`}>Outputs</h2>
                        <ul>
                          {entry.data.outputs.map((output) => (
                            <li>
                              {output.url ? (
                                <a href={output.url}>{output.title}</a>
                              ) : (
                                output.title
                              )}
                            </li>
                          ))}
                        </ul>
                      </section>
                    )}

                    {entry.data.presentations.length > 0 && (
                      <section
                        aria-labelledby={`${entry.data.id}-presentations`}
                      >
                        <h2 id={`${entry.data.id}-presentations`}>
                          Presentations
                        </h2>
                        <ul>
                          {entry.data.presentations.map((presentation) => (
                            <li>{presentation}</li>
                          ))}
                        </ul>
                      </section>
                    )}

                    {entry.data.skills.length > 0 && (
                      <section aria-labelledby={`${entry.data.id}-skills`}>
                        <h2 id={`${entry.data.id}-skills`}>Skills</h2>
                        <ul>
                          {entry.data.skills.map((skill) => (
                            <li>{skill}</li>
                          ))}
                        </ul>
                      </section>
                    )}

                    {entry.data.lessons && (
                      <section aria-labelledby={`${entry.data.id}-lessons`}>
                        <h2 id={`${entry.data.id}-lessons`}>Lessons</h2>
                        <p>{entry.data.lessons}</p>
                      </section>
                    )}

                    {relatedProjects.length > 0 && (
                      <section aria-labelledby={`${entry.data.id}-projects`}>
                        <h2 id={`${entry.data.id}-projects`}>
                          Related projects
                        </h2>
                        <ul>
                          {relatedProjects.map((project) => (
                            <li>
                              <a href={`/projects/${project.slug}`}>
                                {project.title}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </section>
                    )}
                  </div>
                </details>
              </li>
            );
          })}
        </ol>
      ) : (
        <EmptyState message="No public experience entries are ready yet." />
      )
    }

    <section class="experience-note" aria-labelledby="cv-note">
      <SectionHeader
        id="cv-note"
        title="CV"
        intro="The PDF CV will be maintained by hand once real public material is ready."
      />
      <p>
        The future file target is <code>/cv.pdf</code>. No placeholder PDF is
        generated in this phase.
      </p>
    </section>
  </Container>
</BaseLayout>

<style>
  .experience-page {
    display: grid;
    gap: var(--space-8);
    padding-block: clamp(var(--space-7), 8vw, var(--space-11));
  }

  .experience-list {
    border-block-start: 1px solid var(--rule-strong);
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .experience-entry {
    border-block-end: 1px solid var(--rule);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 5rem minmax(0, 1fr);
    padding-block: var(--space-5);
  }

  .experience-entry__year,
  .experience-entry summary,
  .experience-entry__body h2,
  .experience-note code {
    font-family: var(--font-interface);
  }

  .experience-entry__year {
    color: var(--orange-ink);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
  }

  .experience-entry details {
    min-inline-size: 0;
  }

  .experience-entry summary {
    cursor: pointer;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: minmax(0, 1fr) auto;
    letter-spacing: 0.03em;
    list-style-position: outside;
    text-transform: uppercase;
  }

  .experience-entry summary > span:first-child {
    display: grid;
    gap: var(--space-1);
  }

  .experience-entry__role {
    color: var(--ink-900);
    font-family: var(--font-display);
    font-size: var(--step-2);
    letter-spacing: 0;
    line-height: 1;
    text-transform: none;
  }

  .experience-entry__body {
    display: grid;
    gap: var(--space-5);
    padding-block-start: var(--space-5);
  }

  .experience-entry__body h2 {
    color: var(--ink-500);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    margin-block-end: var(--space-2);
    text-transform: uppercase;
  }

  .experience-entry__body p,
  .experience-entry__body li,
  .experience-note p {
    color: var(--ink-700);
  }

  .experience-entry__body ul {
    margin: 0;
    padding-inline-start: var(--space-5);
  }

  .experience-note {
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  @media (max-width: 42rem) {
    .experience-entry {
      grid-template-columns: 1fr;
    }

    .experience-entry summary {
      grid-template-columns: 1fr;
    }
  }
</style>
