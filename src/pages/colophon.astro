---
import Container from '../components/Container.astro';
import MetadataList from '../components/MetadataList.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Colophon — The Starkonium Times"
  description="Technical and editorial notes for The Starkonium Times."
>
  <Container as="article" class="colophon-page">
    <PageHeader
      eyebrow="Colophon"
      title="Colophon"
      standfirst="A record of the site’s materials: typography, palette, stack, licenses, and naming."
    />

    <section class="colophon-section" aria-labelledby="typefaces">
      <SectionHeader id="typefaces" title="Typefaces" level={2} />
      <MetadataList
        items={[
          { label: 'Display', value: 'Fraunces via font tokens' },
          { label: 'Reading', value: 'Newsreader via font tokens' },
          { label: 'Interface', value: 'IBM Plex Mono or system fallback' },
          { label: 'Code', value: 'IBM Plex Mono' },
        ]}
      />
    </section>

    <section class="colophon-section" aria-labelledby="palette">
      <SectionHeader id="palette" title="Palette" level={2} />
      <p>
        Cream paper, black ink, quiet rules, and sparse orange accents. The
        orange is intended for emphasis and navigational marks, not full-page
        decoration.
      </p>
    </section>

    <section class="colophon-section" aria-labelledby="stack">
      <SectionHeader id="stack" title="Stack" level={2} />
      <p>
        Built with Astro, TypeScript, vanilla CSS, content collections, Vitest,
        Playwright smoke tests in CI, ESLint, and Prettier.
      </p>
    </section>

    <section class="colophon-section" aria-labelledby="licenses">
      <SectionHeader id="licenses" title="Licenses" level={2} />
      <p>
        Code is MIT. Site content is CC BY 4.0 unless a page says otherwise.
      </p>
    </section>

    <section class="colophon-section" aria-labelledby="revision-history">
      <SectionHeader id="revision-history" title="Revision history" level={2} />
      <ol class="colophon-revisions">
        <li>Phase 0: repository bootstrap and validation invariants.</li>
        <li>Phase 1: design tokens and global shell.</li>
        <li>Phase 2: content collections and fixtures.</li>
        <li>Phase 3: editorial components.</li>
        <li>Phase 4: homepage.</li>
        <li>Phase 5: project routes.</li>
        <li>Phase 6: writing routes.</li>
        <li>Phase 7: paper review routes.</li>
        <li>Phase 8: personal pages, topics, and 404.</li>
      </ol>
    </section>

    <section class="colophon-section" aria-labelledby="naming">
      <SectionHeader id="naming" title="Naming" level={2} />
      <p>
        The full publication name is The Starkonium Times. The compact header
        wordmark is STARKONIUM.
      </p>
    </section>
  </Container>
</BaseLayout>

<style>
  .colophon-page {
    display: grid;
    gap: var(--space-8);
    padding-block: clamp(var(--space-7), 8vw, var(--space-11));
  }

  .colophon-section {
    display: grid;
    gap: var(--space-4);
    max-inline-size: var(--w-reading);
  }

  .colophon-section p,
  .colophon-revisions {
    color: var(--ink-700);
  }

  .colophon-revisions {
    margin: 0;
    padding-inline-start: var(--space-5);
  }
</style>
