---
import { getCollection } from 'astro:content';

import Container from '../../components/Container.astro';
import EmptyState from '../../components/EmptyState.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { ContentEntry } from '../../utils/content';
import type {
  ExperienceData,
  ProjectData,
  ReviewData,
  TopicData,
  WritingData,
} from '../../utils/content-schemas';
import { labelFromSlug } from '../../utils/format';
import { getTopicCounts, groupTopicsByFacet } from '../../utils/topic-pages';

const topics = (await getCollection('topics')) as ContentEntry<TopicData>[];
const projects = (await getCollection(
  'projects',
)) as ContentEntry<ProjectData>[];
const writing = (await getCollection('writing')) as ContentEntry<WritingData>[];
const reviews = (await getCollection('reviews')) as ContentEntry<ReviewData>[];
const experience = (await getCollection(
  'experience',
)) as ContentEntry<ExperienceData>[];
const groups = groupTopicsByFacet(topics);
const counts = getTopicCounts(topics, {
  projects,
  writing,
  reviews,
  experience,
});
---

<BaseLayout
  title="Topics — The Starkonium Times"
  description="Topics grouped by facet for The Starkonium Times."
>
  <Container as="section" class="topics-page" aria-label="Topics">
    <PageHeader
      eyebrow="Topics"
      title="Topics"
      standfirst="A small controlled vocabulary for connecting projects, writing, reviews, and experience records."
    />

    {
      groups.length > 0 ? (
        <div class="topic-groups">
          {groups.map((group) => (
            <section
              class="topic-group"
              aria-labelledby={`facet-${group.facet}`}
            >
              <SectionHeader
                id={`facet-${group.facet}`}
                title={labelFromSlug(group.facet)}
                level={2}
              />
              <ul>
                {group.entries.map((topic) => (
                  <li>
                    <a href={`/topics/${topic.data.slug}`}>
                      <span>{topic.data.label}</span>
                      <span>
                        {counts.get(topic.data.slug) ?? 0}{' '}
                        {(counts.get(topic.data.slug) ?? 0) === 1
                          ? 'entry'
                          : 'entries'}
                      </span>
                    </a>
                    {topic.data.description && <p>{topic.data.description}</p>}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ) : (
        <EmptyState message="No topics have been configured yet." />
      )
    }
  </Container>
</BaseLayout>

<style>
  .topics-page {
    display: grid;
    gap: var(--space-8);
    padding-block: clamp(var(--space-7), 8vw, var(--space-11));
  }

  .topic-groups {
    display: grid;
    gap: var(--space-7);
  }

  .topic-group {
    display: grid;
    gap: var(--space-4);
  }

  .topic-group ul {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .topic-group li {
    border-block-start: 1px solid var(--rule);
    display: grid;
    gap: var(--space-2);
    padding-block-start: var(--space-3);
  }

  .topic-group a {
    color: var(--ink-900);
    display: flex;
    gap: var(--space-4);
    justify-content: space-between;
    text-decoration: none;
  }

  .topic-group a span:last-child {
    color: var(--orange-ink);
    font-family: var(--font-interface);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .topic-group p {
    color: var(--ink-700);
    max-inline-size: var(--w-reading);
  }
</style>
