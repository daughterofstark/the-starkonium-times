---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
---
<BaseLayout title="The Starkonium Times — Research & Writing" description="Research, computational biology, molecular simulation, software and writing by Medha Sharma.">
  <Container as="section" class="landing">
    <p class="eyebrow">Medha Sharma · Research &amp; writing</p>
    <h1>The Starkonium Times</h1>
    <p class="intro">Research at the intersection of biology, computation, and quantitative methods. A home for my projects, software, notes, and writing.</p>
    <nav class="landing-links" aria-label="Explore the site"><a href="/projects">Explore research</a><a href="/writing">Writing &amp; blog</a><a href="/about">About me</a></nav>
  </Container>
  <Container as="section" class="landing"><h2>Selected research</h2><div class="entries">
    <article><h3>STRIDE</h3><p>Reproducibility-aware analysis of molecular dynamics simulations, developed using dengue NS2B–NS3 systems.</p></article>
    <article><h3>Sarcomere image analysis</h3><p>Quantitative analysis of cardiomyocyte microscopy images: orientation, structure, periodicity, and quality control.</p></article>
    <article><h3>Sodium-channel β-subunits</h3><p>Molecular dynamics and structural analysis of disease-associated β-subunit variants, undertaken during a research studentship at Cambridge.</p></article>
  </div><p><a href="/projects">See the research overview →</a></p></Container>
  <Container as="section" class="landing"><h2>Writing</h2><p>My existing Blogger articles are being preserved as a separate archive. The research website and blog can share this domain while retaining their own publishing workflows.</p><p><a href="/writing">Writing and blog information →</a></p></Container>
</BaseLayout>
<style>
.landing{padding-block:clamp(2.5rem,7vw,6rem);border-bottom:1px solid var(--rule)}
h1{font-size:clamp(3rem,9vw,7rem);line-height:1.04;letter-spacing:-.045em;max-width:100%;overflow-wrap:anywhere}
h2{font-size:clamp(1.8rem,4vw,3rem);margin-block-end:1.25rem}.intro{font-size:clamp(1.1rem,2.5vw,1.5rem);max-width:60ch;line-height:1.6;margin-block:2rem}
.eyebrow{font-family:var(--font-interface);text-transform:uppercase;letter-spacing:.12em;color:var(--orange)}
.landing-links{display:flex;gap:1.2rem;flex-wrap:wrap}.landing-links a{padding:.75rem 0;border-bottom:2px solid var(--orange)}
.entries{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,17rem),1fr));gap:2rem;margin-block:2rem}.entries article{border-top:1px solid var(--rule);padding-top:1.2rem}.entries p{line-height:1.6}
</style>
