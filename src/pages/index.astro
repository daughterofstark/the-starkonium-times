---
import Container from '../components/Container.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="The Starkonium Times"
  description="Phase 1 shell placeholder for The Starkonium Times."
>
  <Container as="section" class="placeholder-page" width="reading">
    <div class="placeholder-page__rule" aria-hidden="true"></div>
    <div class="flow">
      <h1>The Starkonium Times</h1>
      <p>
        This placeholder page verifies the editorial shell, typography, spacing,
        navigation, and footer before real site content arrives in a later
        phase. For now, visit the future <a href="/writing">writing index</a>.
      </p>
    </div>
  </Container>
</BaseLayout>
