---
import ContactBlock from '../components/ContactBlock.astro';
import Container from '../components/Container.astro';
import EditorialRule from '../components/EditorialRule.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About — The Starkonium Times"
  description="A brief provisional about page for The Starkonium Times."
>
  <Container as="article" class="about-page">
    <PageHeader
      eyebrow="About"
      title="About"
      standfirst="A provisional note about the publication while the real archive is still being assembled."
    />

    <section class="about-lede flow" aria-label="About The Starkonium Times">
      <p>
        The Starkonium Times is a public research notebook and writing site by
        Medha Sharma. It is being shaped as a place for project records, paper
        reviews, software notes, essays, and small working logs that can be read
        as an archive rather than a pitch deck.
      </p>
      <p>
        The current site still uses fixture content, so this page avoids final
        biography and research claims. The intended voice is careful, plain, and
        specific: enough context to make work traceable, enough restraint to
        avoid turning unfinished ideas into announcements.
      </p>
    </section>

    <EditorialRule variant="strong" decorative />

    <section class="about-sections" aria-label="Working notes">
      <section class="about-card">
        <SectionHeader id="how-i-work" title="How I work" level={2} />
        <p>
          I prefer records that explain the question, the constraints, the
          decision, and what changed after testing. The site is designed to keep
          those pieces near each other.
        </p>
      </section>

      <section class="about-card">
        <SectionHeader id="curious-about" title="Curious about" level={2} />
        <p>
          Structural biology, reproducible computation, writing systems, and the
          habits that make research easier to inspect later.
        </p>
      </section>

      <section class="about-card">
        <SectionHeader id="away-from-bench" title="Away from bench" level={2} />
        <p>
          Notes here may eventually include books, music, sketches, and other
          quiet inputs, but Phase 8 keeps that material deliberately sparse.
        </p>
      </section>
    </section>

    <ContactBlock />
  </Container>
</BaseLayout>

<style>
  .about-page {
    display: grid;
    gap: var(--space-8);
    padding-block: clamp(var(--space-7), 8vw, var(--space-11));
  }

  .about-lede {
    color: var(--ink-700);
    font-size: var(--step-1);
    max-inline-size: var(--w-reading);
  }

  .about-sections {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .about-card {
    border-block-start: 1px solid var(--rule-strong);
    display: grid;
    gap: var(--space-4);
    padding-block-start: var(--space-4);
  }

  .about-card p {
    color: var(--ink-700);
  }

  @media (max-width: 52rem) {
    .about-sections {
      grid-template-columns: 1fr;
    }
  }
</style>
