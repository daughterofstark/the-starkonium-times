---
import { getCollection } from 'astro:content';

import Container from '../components/Container.astro';
import EmptyState from '../components/EmptyState.astro';
import MetadataList from '../components/MetadataList.astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { ContentEntry } from '../utils/content';
import { slugFromEntry } from '../utils/content';
import type { NowData, ProjectData } from '../utils/content-schemas';
import { getNowHeaderMeta, getNowRows, selectCurrentNow } from '../utils/now';

const nowEntries = (await getCollection('now')) as ContentEntry<NowData>[];
const projects = (await getCollection(
  'projects',
)) as ContentEntry<ProjectData>[];
const entry = selectCurrentNow(nowEntries);
const meta = entry ? getNowHeaderMeta(entry) : null;
const rows = entry ? getNowRows(entry) : [];
const buildingProject = entry?.data.buildingProject
  ? projects.find(
      (project) => slugFromEntry(project) === entry.data.buildingProject,
    )
  : null;
---

<BaseLayout
  title="Now — The Starkonium Times"
  description="The latest Now note for The Starkonium Times."
>
  <Container as="section" class="now-page" aria-label="Now">
    <PageHeader
      eyebrow="Now"
      title="Now"
      standfirst="A current-status note: what is being built, read, revised, and thought through."
    />

    {
      entry && meta ? (
        <article class="now-card">
          <p
            class:list={[
              'now-card__freshness',
              meta.freshness.overdue && 'is-overdue',
            ]}
          >
            {meta.text}
          </p>
          {buildingProject && (
            <p class="now-card__project">
              Building project:{' '}
              <a href={`/projects/${slugFromEntry(buildingProject)}`}>
                {buildingProject.data.title}
              </a>
            </p>
          )}
          {rows.length > 0 ? (
            <MetadataList items={rows} />
          ) : (
            <EmptyState message="The latest Now entry has no public fields yet." />
          )}
        </article>
      ) : (
        <EmptyState message="No Now entry has been published yet." />
      )
    }
  </Container>
</BaseLayout>

<style>
  .now-page {
    display: grid;
    gap: var(--space-8);
    padding-block: clamp(var(--space-7), 8vw, var(--space-11));
  }

  .now-card {
    background: var(--paper-raised);
    border: 1px solid var(--rule-strong);
    display: grid;
    gap: var(--space-5);
    padding: clamp(var(--space-5), 5vw, var(--space-7));
  }

  .now-card__freshness,
  .now-card__project {
    color: var(--ink-500);
    font-family: var(--font-interface);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .now-card__freshness.is-overdue {
    color: var(--orange-ink);
  }

  .now-card__project a {
    color: var(--ink-900);
  }
</style>
