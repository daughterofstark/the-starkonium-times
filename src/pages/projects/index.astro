---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
const projects = [
 {name:'STRIDE — molecular dynamics analysis',desc:'Analysis of reproducibility and biological signal in molecular-dynamics correlation data, including cross-replicate and cross-serotype comparisons of dengue NS2B–NS3.'},
 {name:'Cardiomyocyte sarcomere analysis',desc:'Image-analysis pipeline for measuring sarcomere orientation and spacing in microscopy images, with per-patch quality checks and provenance.'},
 {name:'Nav β-subunit variant simulations',desc:'Cambridge research studentship investigating disease-associated Nav β1 R85H and β3 A130V variants with atomistic molecular dynamics and structural analysis.'},
 {name:'DNAAF interaction screening',desc:'Computational preparation and benchmarking for candidate protein-interaction screens using AlphaPulldown, in collaboration with Oxford.'},
];
---
<BaseLayout title="Research — The Starkonium Times" description="Research projects in molecular dynamics, computational biology and image analysis.">
<Container as="section" class="page"><p class="eyebrow">Research</p><h1>Projects &amp; methods</h1><p class="lede">Selected computational research and scientific software. These are concise project summaries, not claims of peer-reviewed publication.</p>
<div class="list">{projects.map(project => <article><h2>{project.name}</h2><p>{project.desc}</p></article>)}</div><p>For code and selected public repositories, visit <a href="https://github.com/daughterofstark">my GitHub profile</a>.</p></Container>
</BaseLayout><style>.page{padding-block:clamp(3rem,8vw,6rem)}h1{font-size:clamp(2.5rem,6vw,5rem)}.lede{max-width:60ch;font-size:1.2rem;line-height:1.65}.eyebrow{color:var(--orange);text-transform:uppercase;letter-spacing:.13em}.list{margin-block:3rem}.list article{padding-block:1.7rem;border-top:1px solid var(--rule)}.list p{max-width:75ch;line-height:1.7}</style>
